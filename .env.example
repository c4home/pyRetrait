# ==============================================================================
# pyRetrait - Example Environment Variables
# Copy file này thành .env: cp .env.example .env
# ==============================================================================

# Google Gemini API Key
# Nhận API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Phiên bản mô hình Google Gemini AI mặc định
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình Máy chủ (Tùy chọn)
HOST=127.0.0.1
PORT=8000
