# ==============================================================================
# pyRetrait - Example Environment Variables
# Copy file này thành .env: cp .env.example .env
# ==============================================================================

# Google Gemini API Key
# Nhận API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Phiên bản mô hình Google Gemini AI mặc định
GEMINI_MODEL=gemini-3.8-flash

# Cấu hình Máy chủ (Tùy chọn)
HOST=127.0.0.1
PORT=8000

# Khóa ký JWT đăng nhập (BẮT BUỘC cho production, tối thiểu 32 ký tự)
# Nếu bỏ trống, backend dùng khóa ngẫu nhiên tạm thời và mọi người dùng phải
# đăng nhập lại sau mỗi lần restart. Tạo khóa cố định bằng lệnh:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Lưu ý: đổi khóa này sẽ làm mọi token đã cấp mất hiệu lực. KHÔNG commit giá trị thật.
PYRETRAIT_SECRET_KEY=

# Danh sách origin được phép gọi API (ngăn cách bởi dấu phẩy).
# Mặc định (để trống): chỉ http://127.0.0.1:PORT và http://localhost:PORT.
# Giao diện web chạy cùng origin với API nên Docker/Nginx thường KHÔNG cần đặt.
# Ví dụ nếu có frontend ở domain khác: CORS_ORIGINS=https://fire.yourdomain.com
CORS_ORIGINS=
